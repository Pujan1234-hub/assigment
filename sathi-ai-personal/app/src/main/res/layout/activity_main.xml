<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SATHI AI" android:textColor="@color/text" android:textStyle="bold" android:textSize="28sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="तपाईंको आफ्नै नेपाली व्यक्तिगत AI साथी" android:textColor="@color/muted" android:textSize="15sp"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="साथी तयार छ" android:textColor="@color/cyan" android:textSize="18sp"/><Button android:id="@+id/talkButton" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="14dp" android:text="🎙  साथीसँग बोल्नुहोस्" android:textAllCaps="false"/><Button android:id="@+id/backgroundButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="साथीलाई पृष्ठभूमिमा सक्रिय राख्नुहोस्" android:textAllCaps="false"/><EditText android:id="@+id/question" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="नेपालीमा केही सोध्नुहोस्…" android:textColor="@color/text" android:textColorHint="@color/muted"/><Button android:id="@+id/askButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="सोध्नुहोस्" android:textAllCaps="false"/><Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="🔎 वेबमा खोज्नुहोस्"/><Button android:id="@+id/phoneButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📱 फोन नियन्त्रण"/><Button android:id="@+id/studyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📚 कक्षा ८–१२ अध्ययन साथी"/><Button android:id="@+id/notificationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔔 सूचना बुझ्ने अनुमति"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="आवाज नीति: बोल्ने उत्तर केवल नेपालीमा। अंग्रेजी वा हिन्दी आवाज प्रयोग गरिँदैन।" android:textColor="@color/muted"/></LinearLayout></ScrollView>
