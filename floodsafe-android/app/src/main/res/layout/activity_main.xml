<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <ImageView android:layout_width="88dp" android:layout_height="88dp"
            android:src="@drawable/ic_floodsafe" android:contentDescription="@string/title" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/title" android:textColor="#142A42" android:textStyle="bold"
            android:textSize="26sp" android:layout_marginTop="20dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/status"
            android:textColor="#31485E" android:textSize="16sp" android:gravity="center"
            android:layout_marginTop="20dp" />
        <Button android:id="@+id/open_app" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/open_app" android:layout_marginTop="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/safety" android:textColor="#31485E"
            android:textSize="14sp" android:gravity="center" android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
