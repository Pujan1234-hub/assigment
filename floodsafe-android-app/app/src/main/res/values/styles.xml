<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#16A34A</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#EAF6FF</item>
    </style>

    <style name="PJBuiltsSplashTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#030712</item>
        <item name="android:statusBarColor">#030712</item>
        <item name="android:navigationBarColor">#030712</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
