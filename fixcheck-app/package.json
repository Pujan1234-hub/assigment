{
  "name": "fixcheck-app",
  "version": "1.0.0",
  "private": true,
  "description": "FixCheck cross-platform network and service diagnostics app",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "mobile:sync": "npm run prepare:web && cap sync",
    "android:add": "npm run prepare:web && cap add android",
    "ios:add": "npm run prepare:web && cap add ios",
    "desktop:start": "npm run prepare:web && electron .",
    "desktop:dist": "npm run prepare:web && node scripts/decode-icons.mjs && electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/ios": "latest",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "app.fixcheck.network",
    "productName": "FixCheck",
    "asar": true,
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "directories": {"output": "dist", "buildResources": "resources"},
    "win": {"target": ["portable"], "icon": "resources/icon.ico"},
    "mac": {"target": ["zip"], "icon": "resources/icon.png", "category": "public.app-category.utilities"},
    "linux": {"target": ["AppImage"], "icon": "resources/icon.png", "category": "Utility"}
  }
}
